# ========================================================
# LeaseGuard AI - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ========================================================

# --- Supabase Configuration (PostgreSQL Database & Auth) ---
# Will be used in database/storage phases
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- RocketRide AI Pipeline ---
# Pipeline orchestration platform for multi-step AI tasks
ROCKETRIDE_API_KEY=your-rocketride-api-key
ROCKETRIDE_BASE_URL=https://api.rocketride.ai/v1

# --- Gemini API (LLM Engine via RocketRide / Direct) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Application Runtime Settings ---
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
