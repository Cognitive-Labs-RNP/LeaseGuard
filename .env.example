# ========================================================
# LeaseGuard AI - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ========================================================

# --- Supabase Configuration (PostgreSQL Database & Auth) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# Optional legacy values retained for compatibility during transition
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- RocketRide AI Pipeline Cloud Credentials ---
ROCKETRIDE_URI=https://api.rocketride.ai:443
ROCKETRIDE_APIKEY=rr_your_rocketride_user_token

# --- LLM Providers (Managed by RocketRide Cloud Pipeline) ---
# Gemini API Key (Primary LLM Provider)
GEMINI_API_KEY=your-gemini-api-key
ROCKETRIDE_GEMINI_KEY=your-gemini-api-key

# Groq API Key (Fallback LLM Provider)
GROQ_API_KEY=your-groq-api-key
ROCKETRIDE_GROQ_KEY=your-groq-api-key

# --- Application Runtime Settings ---
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

